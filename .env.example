# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# The stack will refuse to start until DB_PASSWORD and DB_ROOT_PASSWORD are set.

# --- WordPress site ---------------------------------------------------------
# Public URL of the store. Must match the port published below.
WP_URL=http://localhost:8080
WP_PORT=8080

# --- Database ---------------------------------------------------------------
# Host port for direct DB access (optional, for debugging only).
DB_PORT=3307
DB_NAME=amino_heaven
DB_USER=amino_heaven
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-root-local-only
DB_PREFIX=wp_

# --- WordPress admin user (created by scripts/setup.sh) ---------------------
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-local-only
WP_ADMIN_EMAIL=admin@example.com

# --- Store details ----------------------------------------------------------
STORE_EMAIL=hello@aminoheaven.com
# Local development only. Replace with real values before taking payments,
# or switch the store to a different payment method.
BANK_ACCOUNT_NAME="PLACEHOLDER — Amino Heaven (set real account name)"
BANK_ACCOUNT_NUMBER="PLACEHOLDER-0000000000"
BANK_NAME="PLACEHOLDER — set bank name"
BANK_SORT_CODE="PLACEHOLDER"
BANK_IBAN="PLACEHOLDER"
BANK_BIC="PLACEHOLDER"

# --- Local HTTPS (optional) -------------------------------------------------
# Set to 1 to expose the site through an HTTPS-terminating proxy on WP_TLS_PORT.
WP_TLS_PORT=8443
